<view class="container">
  <view class="page-title">{{pageLabel}}</view>

  <!-- 步骤 1：微信授权登录 -->
  <block wx:if="{{authState === 'init'}}">
    <view class="step">第 1 步：微信授权登录</view>
    <button class="btn-primary" bindtap="onLoginTap">微信一键登录</button>
  </block>

  <!-- 授权被拒绝引导：openSetting 重授权 -->
  <block wx:if="{{authDenied}}">
    <view class="hint">需要微信授权才能参与活动</view>
    <button class="btn-secondary" open-type="openSetting" bindopensetting="onOpenSetting">前往设置重新授权</button>
  </block>

  <!-- 步骤 2：设置昵称和头像（chooseAvatar + nickname input） -->
  <block wx:if="{{authState === 'profile'}}">
    <view class="step">第 2 步：设置昵称和头像</view>
    <view class="profile-form">
      <view class="row">
        <text class="label">头像</text>
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="avatar" src="{{avatar}}" mode="aspectFill" />
        </button>
      </view>
      <view class="row">
        <text class="label">昵称</text>
        <input
          class="nickname-input"
          type="nickname"
          value="{{nickname}}"
          placeholder="请输入昵称（1-20字）"
          maxlength="20"
          bindinput="onNicknameInput"
          bindblur="onNicknameBlur"
        />
      </view>
      <view class="hint error" wx:if="{{profileDenied}}">昵称或头像提交失败，请重试</view>
    </view>
    <button
      class="btn-primary"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="onSubmitProfile"
    >下一步</button>
  </block>

  <!-- 步骤 3：填写手机号（手动输入 → auth.register 一次性建号） -->
  <block wx:if="{{authState === 'phone'}}">
    <view class="step">第 3 步：填写手机号</view>
    <view class="hint">将作为你的账号手机号，用于身份核实</view>
    <view class="profile-form">
      <view class="row">
        <text class="label">手机号</text>
        <input
          class="nickname-input"
          type="number"
          maxlength="11"
          value="{{phoneInput}}"
          placeholder="请输入11位手机号"
          bindinput="onPhoneInput"
        />
      </view>
    </view>
    <button
      class="btn-primary"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="onSubmitPhone"
    >提交注册</button>
  </block>

  <!-- 手机号校验/注册失败引导 -->
  <block wx:if="{{phoneDenied}}">
    <view class="hint">手机号注册未通过，请确认手机号正确或更换</view>
    <button class="btn-secondary" bindtap="onRetryPhone">重新填写</button>
  </block>
</view>
