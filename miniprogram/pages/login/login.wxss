/* pages/login/login.wxss */
.container {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.step {
  font-size: 28rpx;
  color: #666;
  margin: 24rpx 0 16rpx;
}
.btn-primary {
  margin: 12rpx 0;
}
.btn-secondary {
  margin: 12rpx 0;
  color: #1890ff;
}
.hint {
  color: #999;
  font-size: 26rpx;
  margin: 16rpx 0;
}
.hint.error {
  color: #e64c45;
}

/* 步骤 2：昵称头像表单 */
.profile-form {
  margin: 16rpx 0;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}
.label {
  color: #666;
  font-size: 28rpx;
}
/* chooseAvatar 按钮：去掉 button 默认样式，只承载头像 */
.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: normal;
  min-width: 0;
}
.avatar-btn::after {
  border: none;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f0f0f0;
}
.nickname-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
  margin-left: 24rpx;
}
