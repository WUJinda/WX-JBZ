/* pages/login/login.wxss */
.container {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.step {
  font-size: 28rpx;
  color: #666;
  margin: 24rpx 0 16rpx;
}
.btn-primary {
  margin: 12rpx 0;
}
.btn-secondary {
  margin: 12rpx 0;
  color: #1890ff;
}
.user-card {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}
.nickname {
  font-size: 30rpx;
}
.hint {
  color: #e64c45;
  font-size: 26rpx;
  margin: 16rpx 0;
}
.success {
  color: #52c41a;
  font-size: 28rpx;
  margin-top: 16rpx;
}
