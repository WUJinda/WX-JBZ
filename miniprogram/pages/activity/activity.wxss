/* pages/activity/activity.wxss */
.activity-page {
  padding: 24rpx;
  padding-bottom: 80rpx;
}

/* 头图 */
.cover {
  position: relative;
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eef1f5;
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #4a90d9, #6ab0f3);
}
.cover-tag {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  letter-spacing: 4rpx;
}
.cover-title {
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
  text-align: center;
  padding: 0 32rpx;
}
.status-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #fff;
}
.status-pending { background: #999; }
.status-active { background: #07c160; }
.status-ended { background: #888; }
.status-terminated { background: #e64340; }

/* 信息块 */
.info-block {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
}
.info-label { color: #888; }
.info-value { color: #333; }

/* 倒计时 */
.countdown {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.countdown-label {
  font-size: 26rpx;
  color: #888;
}
.countdown-timer {
  display: flex;
  align-items: baseline;
}
.cd-num {
  font-size: 40rpx;
  font-weight: 600;
  color: #ff6b35;
  margin: 0 4rpx 0 8rpx;
}
.cd-unit {
  font-size: 24rpx;
  color: #666;
}
.countdown-ended {
  font-size: 28rpx;
  color: #999;
}

/* 进度条 */
.progress-block {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}
.progress-meta {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}
.progress-days { color: #4a90d9; }
.progress-bar {
  width: 100%;
  height: 16rpx;
  background: #eef1f5;
  border-radius: 8rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4a90d9, #6ab0f3);
  transition: width 0.3s;
}

/* 规则 */
.rules-block {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}
.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.rules-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
}

/* CTA */
.cta-btn {
  margin: 32rpx 0;
  width: 100% !important;
  background: #07c160;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
}
.cta-disabled {
  background: #ccc !important;
  color: #fff;
}

/* 概览 */
.overview-block {
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}
.overview-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
}
.overview-label { color: #888; }
.overview-value { color: #ff6b35; font-weight: 600; }

/* ===== 比赛结束结算公告弹窗（2026-08-17）===== */
/* 遮罩全屏居中；卡片限宽限高，内容纵向排布，任何超长文本换行/省略，不横向溢出 */
.settle-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.settle-card {
  width: 86%;
  max-width: 640rpx;
  max-height: 76vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.settle-badge {
  align-self: center;
  font-size: 24rpx;
  color: #ff6b35;
  border: 2rpx solid #ff6b35;
  border-radius: 24rpx;
  padding: 4rpx 20rpx;
}
.settle-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
  margin-top: 16rpx;
}
.settle-activity-name {
  text-align: center;
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
  word-break: break-all;
  overflow-wrap: anywhere;
}

/* 部门冠军 */
.settle-champion-block {
  flex-shrink: 0;
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  background: #fff7f2;
  border-radius: 12rpx;
}
.settle-champion-label {
  font-size: 24rpx;
  color: #ff6b35;
}
.settle-champion-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-top: 6rpx;
  word-break: break-all;
  overflow-wrap: anywhere;
}

/* 前十名积分列表：纵向排布；名次固定宽、昵称自适应省略、分值右对齐 */
.settle-top-block {
  flex: 1 1 auto;
  min-height: 0;
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
}
.settle-top-label {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 8rpx;
}
.settle-top-list {
  flex: 1 1 auto;
  min-height: 0;
  max-height: 40vh;
}
.settle-top-item {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  padding: 12rpx 8rpx;
  border-bottom: 1rpx solid #f2f2f2;
}
.settle-top-item:last-child {
  border-bottom: none;
}
.settle-top-rank {
  flex: 0 0 56rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ff6b35;
  text-align: center;
}
.settle-top-name {
  flex: 1 1 auto;
  min-width: 0; /* flex 子项防溢出关键：允许收缩 + 省略 */
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.settle-top-delta {
  flex: 0 0 auto;
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #07c160;
}
.settle-close-btn {
  flex-shrink: 0;
  margin-top: 28rpx;
  width: 100% !important;
  background: #07c160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}
