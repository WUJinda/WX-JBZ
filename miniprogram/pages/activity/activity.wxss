/* pages/activity/activity.wxss */
.activity-page {
  padding: 24rpx;
  padding-bottom: 80rpx;
}

/* 头图 */
.cover {
  position: relative;
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eef1f5;
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4a90d9, #6ab0f3);
}
.cover-title {
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
}
.status-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #fff;
}
.status-pending { background: #999; }
.status-active { background: #07c160; }
.status-ended { background: #888; }

/* 信息块 */
.info-block {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
}
.info-label { color: #888; }
.info-value { color: #333; }

/* 倒计时 */
.countdown {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.countdown-label {
  font-size: 26rpx;
  color: #888;
}
.countdown-timer {
  display: flex;
  align-items: baseline;
}
.cd-num {
  font-size: 40rpx;
  font-weight: 600;
  color: #ff6b35;
  margin: 0 4rpx 0 8rpx;
}
.cd-unit {
  font-size: 24rpx;
  color: #666;
}
.countdown-ended {
  font-size: 28rpx;
  color: #999;
}

/* 进度条 */
.progress-block {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}
.progress-meta {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}
.progress-days { color: #4a90d9; }
.progress-bar {
  width: 100%;
  height: 16rpx;
  background: #eef1f5;
  border-radius: 8rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4a90d9, #6ab0f3);
  transition: width 0.3s;
}

/* 规则 */
.rules-block {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}
.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}
.rules-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
}

/* CTA */
.cta-btn {
  margin: 32rpx 0;
  width: 100% !important;
  background: #07c160;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
}
.cta-disabled {
  background: #ccc !important;
  color: #fff;
}

/* 概览 */
.overview-block {
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}
.overview-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
}
.overview-label { color: #888; }
.overview-value { color: #ff6b35; font-weight: 600; }
