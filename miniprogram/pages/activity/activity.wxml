<!-- 活动主页（启动页，游客可见）—— 对齐 PRD F7 -->
<view class="activity-page">
  <!-- 活动大字报（无图片，活动名为主视觉） -->
  <view class="cover">
    <view class="cover-placeholder">
      <text class="cover-tag">健步走挑战</text>
      <text class="cover-title">{{activity.name}}</text>
    </view>
    <!-- 当前阶段标识 -->
    <view class="status-badge status-{{status}}">{{statusText}}</view>
  </view>

  <!-- 活动信息：起止 + 当前阶段 + 倒计时 -->
  <view class="info-block">
    <view class="info-row">
      <text class="info-label">活动名称</text>
      <text class="info-value">{{activity.name}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">开始时间</text>
      <text class="info-value">{{startTimeText}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">结束时间</text>
      <text class="info-value">{{endTimeText}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">当前阶段</text>
      <text class="info-value">{{statusText}}</text>
    </view>

    <!-- 倒计时（R7.3：精确到日时分；结束当日到 23:59:59；已结束/已终止归零） -->
    <view class="countdown" wx:if="{{countdown}}">
      <text class="countdown-label">{{countdown.label}}</text>
      <view class="countdown-timer" wx:if="{{countdown.status === 'pending' || countdown.status === 'active'}}">
        <text class="cd-num">{{countdown.days}}</text><text class="cd-unit">天</text>
        <text class="cd-num">{{countdown.hours}}</text><text class="cd-unit">时</text>
        <text class="cd-num">{{countdown.minutes}}</text><text class="cd-unit">分</text>
      </view>
      <text class="countdown-ended" wx:else>{{countdown.status === 'terminated' ? '活动已终止' : '活动已结束'}}</text>
    </view>
  </view>

  <!-- 进度条：已进行天数 / 总天数 -->
  <view class="progress-block" wx:if="{{progress}}">
    <view class="progress-meta">
      <text>活动进度</text>
      <text class="progress-days">{{progress.daysElapsed}}/{{progress.daysTotal}} 天</text>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progress.percent}}%"></view>
    </view>
  </view>

  <!-- 活动规则 -->
  <view class="rules-block">
    <view class="block-title">活动规则</view>
    <view class="rules-text">{{activity.rules}}</view>
  </view>

  <!-- CTA（四态：未开始置灰 / 进行中报名 / 进行中已报名我的步数 / 已结束查看战绩） -->
  <button
    class="cta-btn {{cta.disabled ? 'cta-disabled' : ''}}"
    bindtap="onCtaTap"
    disabled="{{cta.disabled}}"
  >{{cta.text}}</button>

  <!-- 数据概览：参与人数 -->
  <view class="overview-block">
    <view class="block-title">数据概览</view>
    <view class="overview-row">
      <text class="overview-label">参与人数</text>
      <text class="overview-value">{{overview.participant_count}}</text>
    </view>
  </view>

  <!-- 比赛结束结算公告弹窗：每次打开小程序后的会话内首次进入本页时弹出一次（「我知道了」仅关闭不记忆；新活动顶替后自动取消） -->
  <view class="settle-mask" wx:if="{{settlementVisible && activity.settlement}}">
    <view class="settle-card">
      <view class="settle-badge">比赛结束</view>
      <view class="settle-title">结算公告</view>
      <view class="settle-activity-name">{{activity.name}}</view>

      <!-- 部门冠军（全小样本无部门奖时隐藏该块） -->
      <view class="settle-champion-block" wx:if="{{activity.settlement.dept_champion}}">
        <view class="settle-champion-label">部门冠军</view>
        <view class="settle-champion-name">{{activity.settlement.dept_champion.dept_name || activity.settlement.dept_champion.dept_id}}</view>
      </view>

      <!-- 前十名积分：纵向排布，每行一名，不横向溢出 -->
      <view class="settle-top-block" wx:if="{{activity.settlement.top.length > 0}}">
        <view class="settle-top-label">前十名积分</view>
        <scroll-view class="settle-top-list" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="settle-top-item" wx:for="{{activity.settlement.top}}" wx:key="rank">
            <text class="settle-top-rank">{{item.rank}}</text>
            <text class="settle-top-name">{{item.nickname}}</text>
            <text class="settle-top-delta">{{item.delta}} 分</text>
          </view>
        </scroll-view>
      </view>

      <button class="settle-close-btn" bindtap="onSettlementClose">我知道了</button>
    </view>
  </view>
</view>
