/* pages/home/home.wxss */
.home-page { padding: 32rpx; }
.page-title { font-size: 36rpx; font-weight: 600; margin-bottom: 24rpx; }

/* 管理员常驻入口（首页直达后台） */
.admin-shortcut {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.admin-shortcut-title { flex: 1; font-size: 28rpx; color: #07c160; font-weight: 600; }
.admin-shortcut-arrow { font-size: 32rpx; color: #ccc; }

/* 活动状态横幅（对齐 activity 页 status-badge 配色：active 绿 / ended 灰 / pending 浅灰） */
.status-badge {
  display: inline-block;
  padding: 6rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}
.status-badge.status-ended { color: #fff; background: #999; }
.status-badge.status-pending { color: #888; background: #f2f3f5; }
.status-badge.status-none { color: #888; background: #f2f3f5; }

.steps-block { display: flex; justify-content: space-between; margin-bottom: 32rpx; }
.steps-card {
  flex: 1;
  margin: 0 8rpx;
  padding: 32rpx 24rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  text-align: center;
}
/* ended 态：最终累计步数单卡（满宽 + 加大数值） */
.steps-card-single { flex: none; width: 100%; padding: 40rpx 24rpx; }
.steps-card-single .steps-value { font-size: 56rpx; }
.steps-label { display: block; font-size: 26rpx; color: #888; margin-bottom: 12rpx; }
.steps-value { display: block; font-size: 48rpx; font-weight: 700; color: #1a1a1a; }
.sync-btn {
  width: 100%;
  background: #07c160;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  margin-bottom: 16rpx;
}
.sync-btn-loading { background: #9ad8b6; }
.last-sync { text-align: center; font-size: 24rpx; color: #999; margin-top: 12rpx; }
.error-tip { text-align: center; font-size: 26rpx; color: #e64340; margin-top: 16rpx; }
.auth-denied-block { margin-top: 32rpx; text-align: center; }
.auth-denied-tip { display: block; font-size: 26rpx; color: #e64340; margin-bottom: 16rpx; }
.resetting-btn { background: #fff; color: #07c160; border: 1rpx solid #07c160; border-radius: 48rpx; font-size: 28rpx; }

/* ended 态：归档提示（替代同步按钮，静态不可点） */
.archived-tip {
  text-align: center;
  font-size: 26rpx;
  color: #888;
  padding: 24rpx;
  background: #f7f8fa;
  border-radius: 48rpx;
  margin-bottom: 16rpx;
}

/* F4：参与天数 / 活动进度 */
.days-block { display: flex; justify-content: space-between; margin-top: 32rpx; margin-bottom: 16rpx; }
.days-card {
  flex: 1;
  margin: 0 8rpx;
  padding: 24rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  text-align: center;
}
.days-label { display: block; font-size: 24rpx; color: #888; margin-bottom: 8rpx; }
.days-value { display: block; font-size: 40rpx; font-weight: 700; color: #1a1a1a; }

/* F4：我的排名入口 */
.rank-entry {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.rank-entry-title { flex: 1; font-size: 28rpx; color: #1a1a1a; }
.rank-entry-value { font-size: 28rpx; color: #07c160; font-weight: 600; }
.rank-entry-tip { font-size: 26rpx; color: #999; }
.rank-entry-arrow { margin-left: 12rpx; font-size: 32rpx; color: #ccc; }

/* F4：步数趋势（纯 CSS 柱状图，禁止图表库） */
.trend-block {
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.trend-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.trend-title { font-size: 30rpx; font-weight: 600; color: #1a1a1a; }
.trend-tabs { display: flex; }
.trend-tab {
  font-size: 24rpx;
  color: #888;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #f2f3f5;
  margin-left: 12rpx;
}
.trend-tab-active { color: #fff; background: #07c160; }

/* 柱状图容器：固定高度 + flex 等分；柱子高度按百分比归一化 */
.trend-bars {
  display: flex;
  align-items: flex-end;
  height: 240rpx;
  padding: 16rpx 0;
}
.trend-bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  margin: 0 4rpx;
}
.trend-bar {
  width: 70%;
  background: #07c160;
  border-radius: 8rpx 8rpx 0 0;
  min-height: 4rpx;
}
.trend-bar-date {
  font-size: 18rpx;
  color: #aaa;
  margin-top: 8rpx;
  transform: scale(0.85);
}

.trend-empty {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 60rpx 0;
}

/* 空态（未开始 / 无活动 / 加载中） */
.empty-state {
  text-align: center;
  padding: 120rpx 32rpx;
}
.empty-title {
  font-size: 32rpx;
  color: #555;
  margin-bottom: 16rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: #999;
}
.empty-admin-btn {
  display: inline-block;
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  background: #07c160;
  color: #fff;
  border-radius: 48rpx;
  font-size: 28rpx;
}
