<!-- 个人主页 + 步数同步入口（对齐 PRD F3） -->
<view class="home-page">
  <view class="page-title">{{pageLabel}}</view>

  <!-- 今日步数 / 累计步数 -->
  <view class="steps-block">
    <view class="steps-card">
      <text class="steps-label">今日步数</text>
      <text class="steps-value">{{todaySteps}}</text>
    </view>
    <view class="steps-card">
      <text class="steps-label">累计步数</text>
      <text class="steps-value">{{totalSteps}}</text>
    </view>
  </view>

  <!-- 同步按钮（idle / failed 状态可点；syncing 中禁用） -->
  <button
    class="sync-btn {{syncState === 'syncing' || syncState === 'authing' ? 'sync-btn-loading' : ''}}"
    bindtap="onSyncTap"
    disabled="{{syncState === 'syncing' || syncState === 'authing'}}"
  >
    <block wx:if="{{syncState === 'authing'}}">授权中...</block>
    <block wx:elif="{{syncState === 'syncing'}}">同步中...</block>
    <block wx:else>同步微信步数</block>
  </button>

  <!-- 最近同步时间 -->
  <view class="last-sync" wx:if="{{lastSyncText}}">最近同步：{{lastSyncText}}</view>

  <!-- 错误提示 -->
  <view class="error-tip" wx:if="{{errorMsg}}">{{errorMsg}}</view>

  <!-- 拒绝授权后：重新授权引导（openSetting） -->
  <view class="auth-denied-block" wx:if="{{syncState === 'authDenied'}}">
    <text class="auth-denied-tip">需授权「微信运动」数据访问才能参与排名</text>
    <button class="resetting-btn" open-type="openSetting" bindopensetting="onOpenSetting">
      前往设置开启授权
    </button>
  </view>

  <!-- F4：参与天数 / 活动进度 -->
  <view class="days-block">
    <view class="days-card">
      <text class="days-label">已参与天数</text>
      <text class="days-value">{{activeDays}}</text>
    </view>
    <view class="days-card">
      <text class="days-label">活动期天数</text>
      <text class="days-value">{{totalDays}}</text>
    </view>
  </view>

  <!-- F4：我的排名入口（R4.4：myRank 为空时引导完成同步） -->
  <view class="rank-entry" bindtap="onMyRankTap">
    <text class="rank-entry-title">我的排名</text>
    <text class="rank-entry-value" wx:if="{{myRank !== null}}">第 {{myRank}} 名</text>
    <text class="rank-entry-tip" wx:else>完成同步后查看排名</text>
    <text class="rank-entry-arrow">›</text>
  </view>

  <!-- F4：步数趋势（R4.2：近 7/30 天切换；R4.3：无数据展示占位） -->
  <view class="trend-block">
    <view class="trend-header">
      <text class="trend-title">步数趋势</text>
      <view class="trend-tabs">
        <text
          class="trend-tab {{trendRange === 7 ? 'trend-tab-active' : ''}}"
          data-range="7"
          bindtap="onTrendRange"
        >近7天</text>
        <text
          class="trend-tab {{trendRange === 30 ? 'trend-tab-active' : ''}}"
          data-range="30"
          bindtap="onTrendRange"
        >近30天</text>
      </view>
    </view>

    <!-- 纯 CSS 柱状图（柱高百分比归一化） -->
    <view class="trend-bars" wx:if="{{!trendEmpty}}">
      <view class="trend-bar-wrap" wx:for="{{trendList}}" wx:key="date">
        <view class="trend-bar" style="height:{{item.heightPct}}%"></view>
        <text class="trend-bar-date">{{item.date}}</text>
      </view>
    </view>

    <!-- R4.3 空态占位 -->
    <view class="trend-empty" wx:else>
      暂无数据，请点击同步步数
    </view>
  </view>
</view>
