/* pages/admin/activity/activity.wxss
  后台活动配置表单样式。
*/
.admin-page { padding: 32rpx; }
.page-title { font-size: 36rpx; font-weight: 600; margin-bottom: 24rpx; }

.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}
.form-row-textarea {
  flex-direction: column;
  align-items: stretch;
}
.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}
.form-row-textarea .form-label {
  width: auto;
  margin-bottom: 12rpx;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.form-picker {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.form-picker.placeholder { color: #bbb; }
.form-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #333;
  padding: 12rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 12rpx;
}
.form-publish {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.publish-text {
  font-size: 28rpx;
  color: #333;
}
.form-error {
  font-size: 24rpx;
  color: #e64340;
  padding: 8rpx 0 0 160rpx;
}
.save-btn {
  width: 100%;
  background: #07c160;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  margin-top: 48rpx;
}
.save-btn[disabled] {
  background: #9ad8b6;
  color: #fff;
}

/* 已终止提示条 */
.terminated-tip {
  font-size: 26rpx;
  color: #e64340;
  background: #fdecec;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-top: 24rpx;
}

/* 终止活动按钮（危险操作，描边样式区别于保存主按钮） */
.terminate-btn {
  width: 100%;
  background: #fff;
  color: #e64340;
  border: 1rpx solid #e64340;
  border-radius: 48rpx;
  font-size: 32rpx;
  margin-top: 24rpx;
}
.terminate-btn[disabled] {
  color: #f0a0a0;
  border-color: #f0a0a0;
}
