/* pages/admin/activity/list.wxss
  后台活动列表样式。复用 admin 现有 token（page-title / state-tip），列表行更简洁（无头像/操作按钮）。
*/
.admin-page { padding: 32rpx; }
.page-title { font-size: 36rpx; font-weight: 600; margin-bottom: 24rpx; }

/* 顶部新建按钮（主按钮，与表单页 save-btn 同色） */
.create-btn {
  width: 100%;
  background: #07c160;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  margin-bottom: 24rpx;
  line-height: 3;
}
/* 去掉小程序 button 默认边框 */
.create-btn::after { border: none; }

.state-tip { font-size: 26rpx; color: #999; padding: 48rpx 0; text-align: center; }

/* 活动列表 */
.act-list { display: flex; flex-direction: column; gap: 16rpx; }
.act-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}
.act-row-hover { background: #f7f8fa; }
.act-main { flex: 1; min-width: 0; }
.act-name {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.act-name-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  max-width: 460rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.badge {
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
  line-height: 1.7;
  flex-shrink: 0;
}
.badge-active { background: #e6f9ec; color: #07c160; }
.badge-pending { background: #f2f2f2; color: #888; }
.badge-ended { background: #f7f7f7; color: #aaa; }
.badge-terminated { background: #fdecec; color: #e64340; }
.act-meta { font-size: 24rpx; color: #999; margin-top: 4rpx; }
.act-arrow { color: #ccc; font-size: 40rpx; margin-left: 16rpx; }
