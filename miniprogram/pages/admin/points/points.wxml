<!-- pages/admin/points/points.wxml
  后台积分台账：规则说明 + 筛选 + 列表 + 调整弹窗。
  红线：只渲染后端下发的非敏感字段（nickname/dept_name/points/total_steps），不渲染 _openid/phone/sync_count。
-->
<view class="admin-page">
  <view class="page-title">{{pageLabel}}</view>

  <!-- 积分规则说明 -->
  <view class="rule-block">
    <view class="rule-title">积分规则</view>
    <view class="rule-line">个人榜 第 1/2/3 名：+5 / +3 / +1 分</view>
    <view class="rule-line">部门榜 第 1 名 部门全员：每人 +2 分</view>
    <view class="rule-tip">活动结束后按最终榜单自动结算一次。下方可手动调整或立即结算。</view>
    <button class="settle-btn" bindtap="onSettle">立即结算</button>
  </view>

  <!-- 筛选栏：关键字 + 部门 picker -->
  <view class="filter-bar">
    <view class="filter-search">
      <input
        class="search-input"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        bindconfirm="onKeywordSearch"
        confirm-type="search"
        placeholder="搜索昵称"
      />
      <view class="search-btn" bindtap="onKeywordSearch">搜索</view>
    </view>
    <picker
      class="filter-dept"
      mode="selector"
      range="{{deptPickerRange}}"
      value="{{deptPickerIndex}}"
      bindchange="onDeptFilterChange"
    >
      <view class="picker-value">部门：{{deptPickerRange[deptPickerIndex] || '全部'}}</view>
    </picker>
  </view>

  <!-- 统计 -->
  <view class="list-meta" wx:if="{{!loading && list.length > 0}}">共 {{totalCount}} 人</view>

  <!-- 加载态 -->
  <view class="state-tip" wx:if="{{loading}}">加载中...</view>

  <!-- 空态占位（本地轨云函数未部署） -->
  <view class="state-tip" wx:if="{{!loading && list.length === 0}}">暂无数据，部署云函数后查看</view>

  <!-- 积分列表 -->
  <view class="point-list" wx:if="{{!loading}}">
    <view class="point-row" wx:for="{{list}}" wx:key="_id">
      <view class="info">
        <view class="nickname">{{item.nickname || '未命名'}}</view>
        <view class="meta">
          <text>{{item.dept_name || item.dept_id || '未分部门'}}</text>
          <text class="dot">·</text>
          <text>{{item.totalStepsText}}步</text>
        </view>
      </view>
      <view class="points {{item.points < 0 ? 'points-danger' : ''}}">{{item.pointsText}}</view>
      <view
        class="adjust-btn"
        data-user-id="{{item._id}}"
        data-nickname="{{item.nickname}}"
        data-points="{{item.points}}"
        bindtap="onOpenAdjust"
      >调整</view>
    </view>
  </view>

  <!-- 分页加载更多 -->
  <view class="load-more" wx:if="{{loadingMore}}">加载中...</view>
  <view class="load-more" wx:if="{{!loading && !loadingMore && !hasMore && list.length > 0}}">没有更多了</view>

  <!-- 调整积分弹窗 -->
  <view class="picker-mask" wx:if="{{showAdjustSheet}}" bindtap="onAdjustCancel"></view>
  <view class="picker-sheet" wx:if="{{showAdjustSheet}}">
    <view class="picker-header">
      <view class="picker-cancel" bindtap="onAdjustCancel">取消</view>
      <view class="picker-title">调整积分</view>
      <view class="picker-confirm" bindtap="onAdjustConfirm">确定</view>
    </view>
    <view class="adjust-target">{{currentUserNickname || '该用户'}} · 当前 {{currentPoints}} 分</view>
    <input
      class="delta-input"
      value="{{deltaInput}}"
      bindinput="onDeltaInput"
      type="text"
      placeholder="输入变动值，如 3 或 -5"
    />
    <view class="adjust-tip">正数加分，负数减分（须为整数）</view>
  </view>
</view>
