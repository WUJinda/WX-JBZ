<!-- pages/admin/whitelist/whitelist.wxml
  后台白名单导入：粘贴 + 预览 + 导入（F8 R8.2）。
  红线：不渲染完整 phone。预览样本为掩码后（前3后2，中间****），仅展示数量 + 掩码样本。
-->
<view class="admin-page">
  <view class="page-title">{{pageLabel}}</view>

  <!-- 粘贴区 -->
  <view class="form-row form-row-textarea">
    <text class="form-label">邀请码列表</text>
    <textarea
      class="form-textarea"
      value="{{rawText}}"
      bindinput="onTextChange"
      placeholder="粘贴邀请码（支持换行/逗号/分号/制表符分隔）"
      auto-height
    />
  </view>

  <!-- 预览 -->
  <view class="preview-block" wx:if="{{rawText}}">
    <view class="preview-summary">
      识别到 <text class="preview-count">{{previewCount}}</text> 个邀请码
      <text class="preview-invalid" wx:if="{{previewInvalid > 0}}">（{{previewInvalid}} 个无效行）</text>
    </view>
    <view class="preview-sample" wx:if="{{previewSample.length > 0}}">
      <text class="sample-item" wx:for="{{previewSample}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- 错误提示 -->
  <view class="form-error" wx:if="{{errorMsg}}">{{errorMsg}}</view>

  <!-- 导入结果 -->
  <view class="result-block" wx:if="{{resultText}}">导入结果：{{resultText}}</view>

  <!-- 导入按钮 -->
  <button class="import-btn" bindtap="onImport" disabled="{{importing}}">
    <block wx:if="{{importing}}">导入中...</block>
    <block wx:else>导入白名单</block>
  </button>
</view>
