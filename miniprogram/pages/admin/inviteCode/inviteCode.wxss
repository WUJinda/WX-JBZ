/* pages/admin/inviteCode/inviteCode.wxss */
.admin-page {
  padding: 24rpx;
}
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.gen-block {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.gen-row {
  display: flex;
  align-items: center;
}
.count-input {
  flex: 1;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}
.gen-btn {
  margin: 0;
  font-size: 28rpx;
  background: #1aad19;
  color: #fff;
  border-radius: 12rpx;
  line-height: 2.2;
}
.gen-btn::after {
  border: none;
}
.gen-result {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666;
}
.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.picker-value {
  font-size: 28rpx;
  color: #333;
}
.list-meta {
  font-size: 26rpx;
  color: #999;
}
.state-tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 48rpx 0;
}
.code-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #f2f2f2;
}
.code-row:last-child {
  border-bottom: none;
}
.code-main {
  display: flex;
  align-items: center;
}
.code-text {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #1a1a1a;
  font-family: monospace;
}
.code-status {
  margin-left: 16rpx;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.status-unused {
  background: #e6f7e6;
  color: #1aad19;
}
.status-used {
  background: #f0f0f0;
  color: #999;
}
.status-disabled {
  background: #fde8e8;
  color: #e64c45;
}
.code-actions {
  display: flex;
  align-items: center;
}
.act-btn {
  font-size: 26rpx;
  color: #1890ff;
  padding: 8rpx 16rpx;
}
.load-more {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 24rpx 0;
}
