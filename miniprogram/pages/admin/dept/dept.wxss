/* pages/admin/dept/dept.wxss
  后台部门管理样式：列表 + 新建/编辑/删除 + 弹窗表单（参考 dashboard.wxss / users.wxss）。
*/
.admin-page { padding: 32rpx; }
.page-title { font-size: 36rpx; font-weight: 600; margin-bottom: 24rpx; }
.state-tip { text-align: center; font-size: 26rpx; color: #999; padding: 60rpx 0; }

/* 部门列表 */
.dept-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.dept-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}
.dept-row:last-child { border-bottom: none; }
.dept-info { flex: 1; min-width: 0; }
.dept-name { font-size: 30rpx; color: #1a1a1a; font-weight: 500; }
.dept-meta { font-size: 24rpx; color: #888; margin-top: 6rpx; }
.dept-actions { display: flex; flex: 0 0 auto; }
.action-btn {
  font-size: 26rpx;
  color: #07c160;
  background: #f7f8fa;
  border: 1rpx solid #07c160;
  border-radius: 32rpx;
  padding: 14rpx 28rpx;
  margin-left: 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.06);
}
.action-btn.danger {
  color: #fa5151;
  border-color: #fa5151;
}

/* 新建按钮 */
.create-btn {
  width: 100%;
  background: #07c160;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
}
.create-btn[disabled] {
  background: #9ad8b6;
  color: #fff;
}

/* 弹窗表单 */
.form-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 10;
}
.form-sheet {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  z-index: 11;
}
.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
  text-align: center;
}
.form-input {
  width: 100%;
  font-size: 30rpx;
  color: #333;
  padding: 24rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}
.form-input:last-of-type {
  margin-bottom: 0;
}
.form-error {
  font-size: 24rpx;
  color: #e64340;
  padding: 12rpx 4rpx 0;
}
.form-actions {
  display: flex;
  margin-top: 24rpx;
}
.form-btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  padding: 16rpx 0;
  border-radius: 48rpx;
}
.form-btn.cancel {
  color: #888;
  background: #f2f3f5;
  margin-right: 16rpx;
}
.form-btn.confirm {
  color: #fff;
  background: #07c160;
}
