/* pages/admin/dashboard/dashboard.wxss
  后台首页样式：模块导航网格 + 指标卡（参考 home.wxss / rank.wxss）。
*/
.admin-page { padding: 32rpx; }
.page-title { font-size: 36rpx; font-weight: 600; margin-bottom: 24rpx; }
.state-tip { text-align: center; font-size: 26rpx; color: #999; padding: 60rpx 0; }

/* 模块导航网格 */
.module-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
}
.module-card {
  width: 33.33%;
  box-sizing: border-box;
  padding: 8rpx;
  text-align: center;
}
.module-card .module-icon {
  font-size: 48rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 0 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.module-card .module-name {
  font-size: 24rpx;
  color: #333;
  padding: 12rpx 0;
}

/* 运维：刷新排行榜按钮 */
.refresh-block { margin-bottom: 32rpx; }
.refresh-btn {
  width: 100%;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
  padding: 20rpx 0;
  line-height: 1.4;
}
.refresh-btn.refreshing { background: #9ad8b6; }
.refresh-btn[disabled] { color: #fff; opacity: 0.85; }

/* 指标卡网格（6 指标，3 列 2 行） */
.metric-grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}
.metric-card {
  width: 33.33%;
  box-sizing: border-box;
  padding: 8rpx;
  text-align: center;
}
.metric-card .metric-label {
  display: block;
  background: #f7f8fa;
  border-radius: 16rpx 16rpx 0 0;
  padding: 24rpx 12rpx 8rpx;
  font-size: 24rpx;
  color: #888;
}
.metric-card .metric-value {
  display: block;
  background: #f7f8fa;
  border-radius: 0 0 16rpx 16rpx;
  padding: 0 12rpx 24rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}

