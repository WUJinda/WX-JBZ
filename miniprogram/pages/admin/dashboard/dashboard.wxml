<!-- pages/admin/dashboard/dashboard.wxml
  后台首页：模块导航 + 数据看板（F8 R8.5）。
  红线：只渲染后端下发的非敏感字段（deptRank 等），不渲染 _openid/完整 phone/sync_count。
-->
<view class="admin-page">
  <view class="page-title">{{pageLabel}}</view>

  <!-- 模块导航（5 个，H3 子页先就位可点击） -->
  <view class="module-grid">
    <view class="module-card" data-mod="activity" bindtap="onModuleTap">
      <view class="module-icon">⚙️</view>
      <view class="module-name">活动配置</view>
    </view>
    <view class="module-card" data-mod="whitelist" bindtap="onModuleTap">
      <view class="module-icon">📋</view>
      <view class="module-name">白名单导入</view>
    </view>
    <view class="module-card" data-mod="users" bindtap="onModuleTap">
      <view class="module-icon">👥</view>
      <view class="module-name">用户管理</view>
    </view>
    <view class="module-card" data-mod="abnormal" bindtap="onModuleTap">
      <view class="module-icon">⚠️</view>
      <view class="module-name">异常步数</view>
    </view>
    <view class="module-card" data-mod="dept" bindtap="onModuleTap">
      <view class="module-icon">🏢</view>
      <view class="module-name">部门管理</view>
    </view>
  </view>

  <!-- 运维：一键刷新排行榜（管理员手动触发 tasks.rankAggregate，覆盖写 RankCache） -->
  <view class="refresh-block">
    <button class="refresh-btn {{refreshing ? 'refreshing' : ''}}" bindtap="onRefreshRank" disabled="{{refreshing}}">
      {{refreshing ? '刷新中...' : '刷新排行榜'}}
    </button>
  </view>

  <!-- 加载态 -->
  <view class="state-tip" wx:if="{{loading}}">加载中...</view>

  <!-- 空态占位（本地轨云函数未部署） -->
  <view class="state-tip" wx:if="{{!loading && empty}}">暂无数据，部署云函数后查看</view>

  <!-- 看板指标 + 趋势 + 部门榜 -->
  <block wx:if="{{!loading && !empty}}">
    <!-- 6 指标卡（参与人数 / 白名单总数 / 参与率 / 累计步数 / 人均 / 有效参与） -->
    <view class="metric-grid">
      <view class="metric-card">
        <text class="metric-label">参与人数</text>
        <text class="metric-value">{{participated}}</text>
      </view>
      <view class="metric-card">
        <text class="metric-label">白名单总数</text>
        <text class="metric-value">{{whitelistTotal}}</text>
      </view>
      <view class="metric-card">
        <text class="metric-label">参与率</text>
        <text class="metric-value">{{rateText}}</text>
      </view>
      <view class="metric-card">
        <text class="metric-label">累计步数</text>
        <text class="metric-value">{{totalSteps}}</text>
      </view>
      <view class="metric-card">
        <text class="metric-label">人均步数</text>
        <text class="metric-value">{{avgSteps}}</text>
      </view>
      <view class="metric-card">
        <text class="metric-label">有效参与</text>
        <text class="metric-value">{{validParticipants}}</text>
      </view>
    </view>

    <!-- 日活趋势（纯 CSS 柱状图，每日有同步行为的用户数） -->
    <view class="trend-block">
      <view class="trend-header">
        <text class="trend-title">日活趋势</text>
      </view>
      <view class="trend-bars" wx:if="{{!dailyActiveEmpty}}">
        <view class="trend-bar-wrap" wx:for="{{dailyActive}}" wx:key="date">
          <view class="trend-bar" style="height:{{item.heightPct}}%"></view>
          <text class="trend-bar-date">{{item.date}}</text>
        </view>
      </view>
      <view class="trend-empty" wx:else>暂无日活数据</view>
    </view>

    <!-- 部门榜（复用 RankCache，R8.5） -->
    <view class="dept-block">
      <view class="block-title">部门榜</view>
      <view class="dept-row" wx:for="{{deptRank}}" wx:key="dept_id">
        <view class="rank-no">{{item.rank}}</view>
        <view class="info">
          <view class="name">
            {{item.dept_name || '未命名部门'}}
            <text class="small-sample" wx:if="{{item.small_sample}}">样本量小</text>
          </view>
          <view class="dept-meta">
            <text>人均 {{item.avg_steps}} 步</text>
            <text class="dot">·</text>
            <text>共 {{item.member_count}} 人</text>
          </view>
        </view>
        <view class="steps">{{item.total_steps}} 步</view>
      </view>
    </view>
  </block>
</view>
