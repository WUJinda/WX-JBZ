/* pages/profile/profile.wxss */
.container {
  padding: 24rpx;
}
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.user-card {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 16rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #f0f0f0;
}
.nickname {
  font-size: 32rpx;
  font-weight: 500;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}
.label {
  color: #666;
  font-size: 28rpx;
}
.value {
  color: #333;
  font-size: 28rpx;
}
.hint {
  color: #999;
  font-size: 26rpx;
  padding: 24rpx 0;
}
.hint.error {
  color: #e64c45;
}
.btn-secondary {
  color: #1890ff;
  margin-top: 16rpx;
}
/* F8 后台管理入口（仅管理员可见） */
.admin-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.admin-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.admin-entry-arrow {
  font-size: 36rpx;
  color: #ccc;
}
/* 账号管理 section（编辑资料 / 登出 / 注销） */
.account-section {
  margin-top: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  overflow: hidden;
}
.acct-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.acct-row:last-child {
  border-bottom: none;
}
.acct-label {
  font-size: 30rpx;
  color: #1a1a1a;
}
.acct-label.danger {
  color: #e64c45;
}
.acct-arrow {
  font-size: 36rpx;
  color: #ccc;
}
