/* pages/profile/profile.wxss */
.container {
  padding: 24rpx;
}
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.user-card {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 16rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #f0f0f0;
}
.nickname {
  font-size: 32rpx;
  font-weight: 500;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}
.label {
  color: #666;
  font-size: 28rpx;
}
.value {
  color: #333;
  font-size: 28rpx;
}
/* 手机号验证入口：用 button 承载 open-type=getPhoneNumber，去掉 button 默认样式 */
.phone-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: normal;
  min-width: 0;
  /* 覆盖 button 默认撑满宽度 + 居中，缩到内容宽度并靠右（.row 的 space-between） */
  width: auto;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}
.phone-btn::after {
  border: none;
}
/* 未验证：主题色提示可点击授权 */
.value.unverified {
  color: #1890ff;
}
.phone-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 8rpx;
}
/* 保底入口：手动填写手机号（getPhoneNumber 组件未开通/唤不出时） */
.phone-fallback {
  padding: 8rpx 0 4rpx;
  text-align: right;
}
.phone-fallback-text {
  font-size: 24rpx;
  color: #1890ff;
}
.hint {
  color: #999;
  font-size: 26rpx;
  padding: 24rpx 0;
}
.hint.error {
  color: #e64c45;
}
.btn-secondary {
  color: #1890ff;
  margin-top: 16rpx;
}
/* F8 后台管理入口（仅管理员可见） */
.admin-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.admin-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.admin-entry-arrow {
  font-size: 36rpx;
  color: #ccc;
}
/* 账号管理 section（编辑资料 / 登出 / 注销） */
.account-section {
  margin-top: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  overflow: hidden;
}
.acct-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.acct-row:last-child {
  border-bottom: none;
}
.acct-label {
  font-size: 30rpx;
  color: #1a1a1a;
}
.acct-label.danger {
  color: #e64c45;
}
.acct-arrow {
  font-size: 36rpx;
  color: #ccc;
}
