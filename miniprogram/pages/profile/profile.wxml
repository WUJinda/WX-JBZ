<view class="container">
  <view class="page-title">{{pageLabel}}</view>

  <block wx:if="{{loading}}">
    <view class="hint">加载中...</view>
  </block>

  <!-- 游客态（未登录）：展示登录引导卡片，不弹框跳转 -->
  <block wx:if="{{!loading && !isLoggedIn}}">
    <view class="guest-card">
      <view class="guest-avatar-placeholder">🏃</view>
      <view class="guest-title">登录后查看个人资料</view>
      <view class="guest-desc">查看你的邀请码、部门、累计步数和排名记录</view>
      <button class="guest-login-btn" bindtap="onGuestLoginTap">微信登录</button>
    </view>
  </block>

  <block wx:if="{{!loading && isLoggedIn && errorMsg}}">
    <view class="hint error">{{errorMsg}}</view>
    <button class="btn-secondary" bindtap="loadProfile">重新加载</button>
  </block>

  <block wx:if="{{!loading && isLoggedIn && !errorMsg}}">
    <!-- 头像 + 昵称 -->
    <view class="user-card">
      <image class="avatar" src="{{avatar || ''}}" mode="aspectFill" />
      <view class="nickname">{{nickname || '未设置昵称'}}</view>
    </view>

    <!-- 邀请码（注册时一次性消费，只读展示） -->
    <view class="row">
      <text class="label">邀请码</text>
      <text class="value {{inviteCode ? '' : 'unverified'}}">{{inviteCode || '未设置'}}</text>
    </view>

    <!-- 部门 -->
    <view class="row">
      <text class="label">部门</text>
      <text class="value">{{deptName || '未加入'}}</text>
    </view>

    <!-- 报名状态 -->
    <view class="row">
      <text class="label">报名状态</text>
      <text class="value">{{joinStatus === 'joined' ? '已报名' : '未报名'}}</text>
    </view>

    <!-- 累计步数 -->
    <view class="row">
      <text class="label">累计步数</text>
      <text class="value">{{totalSteps}}</text>
    </view>

    <!-- 后台管理入口（仅管理员可见，F8） -->
    <view class="admin-entry" wx:if="{{adminVisible}}" bindtap="onAdminEntry">
      <text class="admin-entry-title">后台管理</text>
      <text class="admin-entry-arrow">›</text>
    </view>

    <!-- 账号管理：编辑资料 / 登出 / 注销 -->
    <view class="account-section">
      <view class="acct-row" bindtap="onEditProfile">
        <text class="acct-label">编辑资料</text>
        <text class="acct-arrow">›</text>
      </view>
      <view class="acct-row" bindtap="onLogout">
        <text class="acct-label">登出账号</text>
        <text class="acct-arrow">›</text>
      </view>
      <view class="acct-row" bindtap="onCancelAccount">
        <text class="acct-label danger">注销账号</text>
        <text class="acct-arrow">›</text>
      </view>
    </view>
  </block>
</view>
