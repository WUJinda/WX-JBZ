/* pages/profile/edit/edit.wxss */
.container {
  padding: 24rpx;
}
.hint {
  color: #999;
  font-size: 26rpx;
  padding: 24rpx 0;
}
.hint.error {
  color: #e64c45;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}
.label {
  color: #666;
  font-size: 28rpx;
}
/* chooseAvatar 按钮：去掉 button 默认样式，只承载头像 */
.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: normal;
  min-width: 0;
}
.avatar-btn::after {
  border: none;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f0f0f0;
}
.nickname-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
  margin-left: 24rpx;
}
.save-btn {
  margin-top: 48rpx;
}
