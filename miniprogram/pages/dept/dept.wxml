<view class="container">
  <view class="title">选择你的部门</view>
  <view class="subtitle">部门即团队，选定后不可更换（报名活动请在活动页操作）</view>

  <view class="dept-list">
    <view
      wx:for="{{departments}}"
      wx:key="dept_id"
      class="dept-item {{selectedDeptId === item.dept_id ? 'selected' : ''}}"
      data-id="{{item.dept_id}}"
      bindtap="onDeptTap"
    >
      <view class="dept-radio">
        <view wx:if="{{selectedDeptId === item.dept_id}}" class="radio-dot"></view>
      </view>
      <view class="dept-info">
        <view class="dept-name">{{item.name}}</view>
        <view class="dept-meta">已报名 {{item.member_count}} 人</view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <view wx:if="{{errorMsg}}" class="error">{{errorMsg}}</view>

  <button
    class="confirm-btn"
    type="primary"
    disabled="{{!selectedDeptId || submitting}}"
    loading="{{submitting}}"
    bindtap="onConfirmTap"
  >确认加入</button>
</view>
