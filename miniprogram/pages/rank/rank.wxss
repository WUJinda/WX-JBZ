/* pages/rank/rank.wxss
  排行榜页样式（F5/F6）。
  - 列表项 / 头像 / 名次 / 步数
  - 我的排名条 fixed 底部
  - 本人高亮（is-me）
  - 小部门标注（small_sample）
  - 空态
*/
.rank-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx; /* 为底部我的排名条留位 */
}

/* 顶部 Tab */
.tab-bar {
  display: flex;
  background: #ffffff;
  border-bottom: 1rpx solid #eee;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666;
}
.tab-active {
  color: #1aad19;
  font-weight: 600;
  border-bottom: 4rpx solid #1aad19;
}

/* metric 切换 */
.metric-bar {
  display: flex;
  background: #ffffff;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}
.metric-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 8rpx;
}
.metric-active {
  color: #ffffff;
  background: #1aad19;
}

/* 列表 */
.list-wrap {
  padding: 16rpx 24rpx;
}

/* 个人榜行 / 成员行 */
.rank-row {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
}
.rank-row.is-me {
  background: #eafbee;
  border: 2rpx solid #1aad19;
}
.rank-no {
  width: 64rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #1aad19;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #1aad19;
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 20rpx;
}
.info {
  flex: 1;
  overflow: hidden;
}
.name {
  font-size: 28rpx;
  color: #333;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.me-tag {
  font-size: 20rpx;
  color: #ffffff;
  background: #1aad19;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.dept {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.steps {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

/* 部门榜行 */
.dept-row {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
}
.dept-row:active {
  background: #f5f5f5;
}
.dept-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.dot {
  margin: 0 8rpx;
}
.small-sample {
  font-size: 20rpx;
  color: #e6a23c;
  background: #fdf6ec;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 24rpx 0;
}

/* 空态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 部门明细头 */
.members-header {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 24rpx;
  border-bottom: 1rpx solid #eee;
}
.back-btn {
  font-size: 30rpx;
  color: #1aad19;
  padding-right: 24rpx;
}
.members-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

/* 我的排名条 / 我的部门卡（固定底部） */
.my-rank-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 2rpx solid #eee;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
  /* 适配 tabBar 高度（小程序原生 tabBar 约 100rpx） */
  bottom: calc(100rpx);
}
.my-rank-left {
  flex: 1;
  overflow: hidden;
}
.my-rank-no {
  font-size: 30rpx;
  font-weight: 600;
  color: #1aad19;
}
.my-rank-neighbors {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}
.my-rank-steps {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

/* 更新时间 */
.updated-at {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  padding: 24rpx 0 120rpx;
}

/* ===== 个人榜二级 Tab：累计榜 / 今日榜 ===== */
.subtab-bar {
  display: flex;
  background: #ffffff;
  padding: 0 24rpx;
  gap: 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.subtab-item {
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #999;
  position: relative;
}
.subtab-active {
  color: #1aad19;
  font-weight: 600;
}
.subtab-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 40rpx;
  height: 4rpx;
  background: #1aad19;
  border-radius: 2rpx;
  transform: translateX(-50%);
}

/* ===== 今日榜日期选择器（固定底部 = 参考图红框位置） ===== */
/* 高度基准：padding 12rpx*2 + chip 72rpx = 96rpx；my-rank-bar.with-picker 与
   rank-page.has-picker 据此量让位 / 留白。 */
.day-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 100rpx; /* 贴原生 tabBar 正上方 */
  z-index: 99;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-top: 2rpx solid #eee;
  padding: 12rpx 16rpx;
}
.day-arrow {
  flex: none;
  width: 40rpx;
  text-align: center;
  font-size: 32rpx;
  color: #ccc;
  line-height: 72rpx;
}
.day-scroll-wrap {
  flex: 1;
  overflow: hidden;
}
.day-scroll {
  width: 100%;
  white-space: nowrap;
}
.day-list {
  display: flex;
  width: -webkit-fit-content;
  width: fit-content;
  gap: 16rpx;
  padding: 0 8rpx;
}
.day-chip {
  flex: none;
  position: relative;
  min-width: 96rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.day-chip-active {
  background: #1aad19;
  color: #ffffff;
  font-weight: 600;
}
.day-today {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  font-size: 18rpx;
  color: #ffffff;
  background: #f56c6c;
  border-radius: 18rpx;
  padding: 0 8rpx;
  line-height: 24rpx;
}
.day-empty {
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  line-height: 72rpx;
}

/* 今日榜模式：我的排名条上移让位日期选择器 */
.my-rank-bar.with-picker {
  bottom: calc(100rpx + 96rpx);
}

/* 今日榜模式：列表底部留白覆盖 日期选择器 + 排名条 + tabBar */
.rank-page.has-picker {
  padding-bottom: calc(100rpx + 96rpx + 110rpx);
}
