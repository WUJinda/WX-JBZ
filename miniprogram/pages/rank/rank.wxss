/* pages/rank/rank.wxss
  排行榜页样式（F5/F6）。
  - 列表项 / 头像 / 名次 / 步数
  - 我的排名条 fixed 底部
  - 本人高亮（is-me）
  - 小部门标注（small_sample）
  - 空态
*/
.rank-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx; /* 为底部我的排名条留位 */
}

/* 顶部固定区（tab-bar + subtab-bar）：sticky 吸顶，列表滚动时常驻顶部。
   sticky 在文档流正常占位，列表自然排在其下方，无需额外 padding-top 补偿。 */
.rank-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: #ffffff;
}

/* 顶部 Tab */
.tab-bar {
  display: flex;
  background: #ffffff;
  border-bottom: 1rpx solid #eee;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666;
}
.tab-active {
  color: #1aad19;
  font-weight: 600;
  border-bottom: 4rpx solid #1aad19;
}

/* metric 切换 */
.metric-bar {
  display: flex;
  background: #ffffff;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}
.metric-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 8rpx;
}
.metric-active {
  color: #ffffff;
  background: #1aad19;
}

/* 列表 */
.list-wrap {
  padding: 16rpx 24rpx;
}

/* 个人榜行 / 成员行 */
.rank-row {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
}
.rank-row.is-me {
  background: #eafbee;
  border: 2rpx solid #1aad19;
}
.rank-no {
  width: 64rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #1aad19;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #1aad19;
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 20rpx;
}
.info {
  flex: 1;
  overflow: hidden;
}
.name {
  font-size: 28rpx;
  color: #333;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.me-tag {
  font-size: 20rpx;
  color: #ffffff;
  background: #1aad19;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.dept {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.steps {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

/* 部门榜行 */
.dept-row {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
}
.dept-row:active {
  background: #f5f5f5;
}
.dept-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.dot {
  margin: 0 8rpx;
}
.small-sample {
  font-size: 20rpx;
  color: #e6a23c;
  background: #fdf6ec;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 24rpx 0;
}

/* 空态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 部门明细头 */
.members-header {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 24rpx;
  border-bottom: 1rpx solid #eee;
}
.back-btn {
  font-size: 30rpx;
  color: #1aad19;
  padding-right: 24rpx;
}
.members-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

/* 我的排名条 / 我的部门卡（固定底部） */
.my-rank-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 2rpx solid #eee;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
  /* bottom:0 即贴 tabBar 顶部——tabBar 页面 fixed 的 0 参照 webview 可视区底（=tabBar 上方），
     无需额外避让（早先 100rpx / --tabbar-h 避让反而把元件顶上去、留出灰底空档）。 */
  bottom: 0;
}
.my-rank-left {
  flex: 1;
  overflow: hidden;
}
.my-rank-no {
  font-size: 30rpx;
  font-weight: 600;
  color: #1aad19;
}
.my-rank-neighbors {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}
.my-rank-steps {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

/* 更新时间 */
.updated-at {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  padding: 24rpx 0 120rpx;
}

/* ===== 个人榜二级 Tab：累计榜 / 今日榜 ===== */
.subtab-bar {
  display: flex;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}
.subtab-item {
  flex: 1; /* 两个页签各占一半宽度（同顶部 tab-bar 写法） */
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #999;
  position: relative;
}
.subtab-active {
  color: #1aad19;
  font-weight: 600;
}
.subtab-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 40rpx;
  height: 4rpx;
  background: #1aad19;
  border-radius: 2rpx;
  transform: translateX(-50%);
}

/* ===== 今日榜日期选择器（固定底部 = 参考图红框位置） ===== */
/* 高度基准：padding-top 10px + chip 72rpx + padding-bottom 12rpx + border-top 2rpx
   = calc(10px + 86rpx)；with-picker 让位 / has-picker 留白据此量。 */
.day-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0; /* 贴 tabBar 顶部（fixed 的 0 已在 webview 可视区底 = tabBar 上方） */
  z-index: 99;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-top: 2rpx solid #eee;
  padding: 10px 16rpx 12rpx; /* 顶部 10px 留白（胶囊距选择器顶边） */
}
.day-arrow {
  flex: none;
  width: 40rpx;
  text-align: center;
  font-size: 32rpx;
  color: #ccc;
  line-height: 72rpx;
}
.day-scroll-wrap {
  flex: 1;
  overflow: hidden;
}
.day-scroll {
  width: 100%;
  white-space: nowrap;
}
.day-list {
  display: flex;
  width: -webkit-fit-content;
  width: fit-content;
  gap: 16rpx;
  padding: 0 8rpx;
}
.day-chip {
  flex: none;
  position: relative;
  min-width: 96rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.day-chip-active {
  background: #1aad19;
  color: #ffffff;
  font-weight: 600;
}
.day-today {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  font-size: 18rpx;
  color: #ffffff;
  background: #f56c6c;
  border-radius: 18rpx;
  padding: 0 8rpx;
  line-height: 24rpx;
}
.day-empty {
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  line-height: 72rpx;
}

/* 今日榜模式：我的排名条上移让位日期选择器（= 日期选择器总高 calc(10px+86rpx)） */
.my-rank-bar.with-picker {
  bottom: calc(10px + 86rpx);
}

/* 今日榜模式：列表底部留白覆盖 日期选择器(calc(10px+86rpx)) + 排名条(~110rpx) */
.rank-page.has-picker {
  padding-bottom: calc(10px + 86rpx + 110rpx);
}
